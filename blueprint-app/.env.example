# Copy to .env for local development:  cp .env.example .env
# On Railway, set these as service Variables instead (never commit real values).

# Password for the internal dashboard (/projects, /projects/:id) and the
# internal Blueprint views (/app, /presentation, /source-map, /decision-tree).
# Gated routes return 500 until this is set. The /intake form stays public.
ADMIN_PASSWORD=change-me

# PORT is provided automatically by Railway — do not set it there.
# Only uncomment locally if you want a fixed port (defaults to 3000).
# PORT=3000
