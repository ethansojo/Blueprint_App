# Copy to .env for local development:  cp .env.example .env
# On Railway, set these as service Variables instead (optional).

# There is NO password / login. The internal dashboard lives at an unlisted
# path, /projects-<random-slug>, and that URL is the only barrier.
#
# By default the slug is generated once and persisted on the data volume
# (so it stays the same across redeploys). It is printed in the boot logs.
# Set DASHBOARD_SLUG below ONLY if you want to choose a fixed, known slug
# instead of the generated one.
# DASHBOARD_SLUG=my-secret-slug

# PORT is provided automatically by Railway — do not set it there.
# Only uncomment locally if you want a fixed port (defaults to 3000).
# PORT=3000
